# ============================================================
#  Variables d'environnement — à configurer dans Vercel
#  (Settings → Environment Variables). NE JAMAIS mettre ces
#  clés dans le code ni sur GitHub.
# ============================================================

# Clé SECRÈTE Stripe (commence par sk_test_... puis sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Uniquement si tu actives l'envoi automatique du billet (webhook) ---

# Secret du webhook Stripe (commence par whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Clé API du service d'email Resend (commence par re_...)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice (domaine vérifié dans Resend)
MAIL_FROM=Bal de Promo <billet@ton-domaine.fr>
